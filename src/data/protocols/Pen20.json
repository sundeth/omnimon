{
  "protocol": {
    "name": "PEN20",
    "display_name": "PEN20 (Pendulum 20th)",
    "type": "battle",
    "version": "1.0",
    "description": "Pendulum 20th battle protocol",
    "packet_count": 10,
    "fixed_hp": 5,
    "uses_minigame": true,
    "minigame_type": "dummy",
    "battle_mode": "single",
    "attack_pattern_file": "attack_patterns/DM20.json"
  },

  "constants": {
    "EOL": {
      "value": 14,
      "bits": 4,
      "type": "int",
      "description": "End of line marker (0x0E = 1110 binary)"
    },
    "VERSION": {
      "value": 1,
      "bits": 4,
      "type": "int",
      "description": "Device version - use pet.version filtered to range 0..5"
    },
    "COU": {
      "value": 0,
      "bits": 2,
      "type": "int",
      "description": "Constant or unknown field"
    }
  },

  "power_bonuses": {
    "egg_shake_bonus": 10,
    "traited_bonuses": {
      "3": 5,
      "4": 8,
      "5": 15,
      "6": 20
    }
  },

  "packets": [
    {
      "number": 1,
      "description": "Order, COU, Attack, Operation, Version, EOL",
      "fields": [
        { "name": "order", "bits": 1, "type": "int", "description": "Battle order (0=device1/replying, 1=device2/initiating)" },
        { "name": "cou", "bits": 1, "type": "int", "description": "Constant field", "default": 0 },
        { "name": "attack", "bits": 4, "type": "int", "description": "Attack pattern index (minigame taps 0-14)", "min": 0, "max": 14 },
        { "name": "operation", "bits": 2, "type": "int", "description": "Battle operation mode", "values": { "0": "single", "1": "tag", "2": "unknown" } },
        { "name": "version", "bits": 4, "type": "int", "ref": "VERSION" },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 2,
      "description": "COU, Index L, Attribute L, EOL",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "index", "bits": 8, "type": "int", "description": "Digimon roster index", "min": 0, "max": 255 },
        { "name": "attribute", "bits": 2, "type": "int", "description": "Digimon attribute (Va=0,Da=1,Vi=2,Fr=3)", "values": { "0": "vaccine", "1": "data", "2": "virus", "3": "free" } },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 3,
      "description": "COU, Shot W L (Weak shot), EOL",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_w", "bits": 8, "type": "int", "description": "Weak shot sprite index", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 4,
      "description": "Sick, COU, Shot S L (Strong shot), EOL",
      "fields": [
        { "name": "sick", "bits": 1, "type": "int", "description": "Sick status", "values": { "0": "healthy", "1": "sick" } },
        { "name": "cou", "bits": 3, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_s", "bits": 8, "type": "int", "description": "Strong shot sprite index", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 5,
      "description": "COU, Traited, Egg Shake, Power L, EOL",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "traited", "bits": 1, "type": "int", "description": "Trait status (+power based on stage)", "values": { "0": "no_trait", "1": "traited" } },
        { "name": "egg_shake", "bits": 1, "type": "int", "description": "Egg shake status (+10 power)", "values": { "0": "no_shake", "1": "shaken" } },
        { "name": "power", "bits": 8, "type": "int", "description": "Power value (includes traited/shake bonuses)", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 6,
      "description": "Copy, Index R, Attribute R, EOL (Right Digimon for tag, 0 for single)",
      "fields": [
        { "name": "copy", "bits": 2, "type": "int", "description": "Copy field", "default": 0 },
        { "name": "index_r", "bits": 8, "type": "int", "description": "Right Digimon index (0 for single)", "default": 0 },
        { "name": "attribute_r", "bits": 2, "type": "int", "description": "Right Digimon attribute", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 7,
      "description": "COU, Shot W R, EOL (0 for single)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_w_r", "bits": 8, "type": "int", "description": "Right Digimon weak shot (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 8,
      "description": "COU, Shot S R, EOL (0 for single)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_s_r", "bits": 8, "type": "int", "description": "Right Digimon strong shot (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 9,
      "description": "COU, Power R, EOL (0 for single)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "power_r", "bits": 8, "type": "int", "description": "Right Digimon power (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 10,
      "description": "Battle results - Check, Dodges (hit_me), Hits (hit_you), EOL",
      "fields": [
        { "name": "check", "bits": 4, "type": "int", "description": "Checksum value", "calculated": true },
        { "name": "hit_me", "bits": 4, "type": "int", "description": "Which of MY attacks hit opponent (4 bits, right to left)", "min": 0, "max": 15 },
        { "name": "hit_you", "bits": 4, "type": "int", "description": "Which of OPPONENT attacks hit me (4 bits, right to left)", "min": 0, "max": 15 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    }
  ],

  "notes": {
    "fixed_hp": "All battles use 5 HP",
    "battle_turns": "5 turns (turn 5 uses turn 1's pattern and hit values)",
    "minigame": "Dummy charge minigame (0-14 taps)",
    "traited_bonus": "Stage 3: +5, Stage 4: +8, Stage 5: +15, Stage 6+: +20",
    "egg_shake_bonus": "+10 power if egg was shaken",
    "attribute_advantage": "Provides +32 power bonus",
    "checksum_calculation": "Sum all nibbles from packets 1-9 plus PacketA nibbles, check makes total % 16 == 0",
    "hit_interpretation": "hit_me = my attacks that hit opponent, hit_you = opponent attacks that hit me",
    "attribute_mapping": "Attribute encoding: Va=0, Da=1, Vi=2, Fr=3"
  }
}
