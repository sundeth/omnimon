{
  "protocol": {
    "name": "DM",
    "display_name": "DM (Digital Monster Original)",
    "type": "battle",
    "version": "1.0",
    "description": "Original Digital Monster battle protocol using slot-based system",
    "packet_count": 2,
    "fixed_hp": 5,
    "uses_minigame": false,
    "battle_mode": "single",
    "attack_pattern_file": "attack_patterns/DM.json",
    "note": "Winner determined by slot matchup table with boost modifiers"
  },

  "constants": {
    "VERSION": {
      "value": 1,
      "bits": 4,
      "type": "int",
      "description": "Device version"
    },
    "MAX_BOOST": {
      "value": 4,
      "type": "int",
      "description": "Maximum boost value (0-4, from pills)"
    },
    "TURNS": {
      "value": 4,
      "type": "int",
      "description": "Number of battle turns (3 normal + 1 final)"
    }
  },

  "slots": {
    "description": "Slot mapping based on power level",
    "power_to_slot": {
      "A": {"min": 0, "max": 10, "hex": "0x3"},
      "B": {"min": 11, "max": 15, "hex": "0x4"},
      "C": {"min": 16, "max": 20, "hex": "0x5"},
      "D": {"min": 21, "max": 25, "hex": "0x6"},
      "E": {"min": 26, "max": 30, "hex": "0x7"},
      "F": {"min": 31, "max": 35, "hex": "0x8"},
      "G": {"min": 36, "max": 40, "hex": "0x9"},
      "H": {"min": 41, "max": 45, "hex": "0xA"},
      "I": {"min": 46, "max": 50, "hex": "0xB"},
      "J": {"min": 51, "max": 55, "hex": "0xC"},
      "K": {"min": 56, "max": 59, "hex": "0xD"},
      "L": {"min": 60, "max": 999, "hex": "0xE"}
    }
  },

  "matchup_table": {
    "description": "Win chance out of 16 for each slot matchup (row vs column)",
    "slots": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"],
    "table": [
      [8, 8, 2, 3, 2, 3, 2, 3, 7, 1, 1, 1],
      [8, 8, 2, 3, 2, 3, 2, 3, 7, 1, 1, 1],
      [15, 15, 8, 11, 9, 11, 7, 11, 13, 3, 3, 3],
      [13, 13, 5, 8, 5, 9, 5, 7, 11, 2, 2, 2],
      [15, 15, 7, 11, 8, 11, 9, 11, 13, 3, 3, 3],
      [13, 13, 5, 7, 5, 8, 5, 9, 11, 2, 2, 2],
      [15, 15, 9, 11, 7, 11, 8, 11, 13, 3, 3, 3],
      [13, 13, 5, 9, 5, 7, 5, 8, 11, 2, 2, 2],
      [9, 9, 3, 5, 3, 5, 3, 5, 8, 1, 1, 1],
      [15, 15, 13, 14, 13, 14, 13, 14, 15, 8, 5, 5],
      [15, 15, 13, 14, 13, 14, 13, 14, 15, 11, 8, 5],
      [15, 15, 13, 14, 13, 14, 13, 14, 15, 11, 11, 8]
    ]
  },

  "packets": [
    {
      "number": 1,
      "description": "Digimon Data Packet",
      "fields": [
        { "name": "boost_mirror", "bits": 4, "type": "int", "description": "Mirrored boost value (inverted bits)", "calculated": true },
        { "name": "slot_mirror", "bits": 4, "type": "int", "description": "Mirrored slot value (inverted bits)", "calculated": true },
        { "name": "boost", "bits": 4, "type": "int", "description": "Boost value 0-4", "min": 0, "max": 4 },
        { "name": "slot", "bits": 4, "type": "int", "description": "Slot hex value (3-E)", "min": 3, "max": 14 }
      ]
    },
    {
      "number": 2,
      "description": "Battle Result Packet",
      "fields": [
        { "name": "version_mirror", "bits": 4, "type": "int", "description": "Mirrored version value (inverted bits)", "calculated": true },
        { "name": "outcome_mirror", "bits": 4, "type": "int", "description": "Mirrored outcome value (inverted bits)", "calculated": true },
        { "name": "version", "bits": 4, "type": "int", "ref": "VERSION" },
        { "name": "outcome", "bits": 4, "type": "int", "description": "Battle outcome", "values": { "1": "victory", "2": "defeat" } }
      ]
    }
  ],

  "notes": {
    "mirrored_values": "Each mirrored value is the bit-inverted version of its source (e.g., 0011 -> 1100)",
    "outcome_calculation": "Win probability = (matchup_table[my_slot][opponent_slot] + boost_advantage) / 16",
    "boost_advantage": "Each boost level adds to win chance, capped at values that keep probability reasonable",
    "pendulum_advantage": "Pendulum devices always send boost=7 and slot=L to maximize win chance against originals"
  }
}
