{
  "protocol": {
    "name": "PENC",
    "display_name": "PENC (Pendulum COLOR)",
    "type": "battle",
    "version": "1.0",
    "description": "Digimon Pendulum COLOR battle protocol",
    "packet_count": 10,
    "fixed_hp": null,
    "uses_minigame": true,
    "battle_mode": "single",
    "attack_pattern_file": "attack_patterns/PENC.json"
  },

  "constants": {
    "EOL": {
      "value": 15,
      "bits": 4,
      "type": "int",
      "description": "End of line marker (0x0F = 1111 binary)"
    },
    "VERSION": {
      "value": 1,
      "bits": 4,
      "type": "int",
      "description": "Protocol version"
    },
    "COU": {
      "value": 0,
      "bits": 2,
      "type": "int",
      "description": "Constant or unknown field"
    }
  },

  "packets": [
    {
      "number": 1,
      "description": "Order, COU, Attack, Operation, Version",
      "fields": [
        { "name": "order", "bits": 1, "type": "int", "description": "Battle order (0=device1, 1=device2)" },
        { "name": "cou", "bits": 1, "type": "int", "description": "Constant field", "default": 0 },
        { "name": "attack", "bits": 4, "type": "int", "description": "Attack pattern index (0-14)", "min": 0, "max": 14 },
        { "name": "operation", "bits": 2, "type": "int", "description": "Battle operation mode", "values": { "0": "single" } },
        { "name": "version", "bits": 4, "type": "int", "ref": "VERSION" },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 2,
      "description": "COU, Index, Attribute",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "index", "bits": 8, "type": "int", "description": "Digimon roster index", "min": 0, "max": 255 },
        { "name": "attribute", "bits": 2, "type": "int", "description": "Digimon attribute", "values": { "0": "vaccine", "1": "data", "2": "virus", "3": "free" } },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 3,
      "description": "COU, Shot W (Weak shot)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_w", "bits": 8, "type": "int", "description": "Weak shot sprite index", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 4,
      "description": "Sick, COU, Shot S (Strong shot)",
      "fields": [
        { "name": "sick", "bits": 1, "type": "int", "description": "Sick status", "values": { "0": "healthy", "1": "sick" } },
        { "name": "cou", "bits": 3, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_s", "bits": 8, "type": "int", "description": "Strong shot sprite index", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 5,
      "description": "COU, Traited, Egg Shake, Power",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "traited", "bits": 1, "type": "int", "description": "Trait status", "values": { "0": "no_trait", "1": "traited" } },
        { "name": "egg_shake", "bits": 1, "type": "int", "description": "Egg shake status", "values": { "0": "no_shake", "1": "shake" } },
        { "name": "power", "bits": 8, "type": "int", "description": "Power value", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 6,
      "description": "Copy, Index R, Attribute R (Right Digimon for tag, 0 for single)",
      "fields": [
        { "name": "copy", "bits": 2, "type": "int", "description": "Copy field", "default": 0 },
        { "name": "index_r", "bits": 8, "type": "int", "description": "Right Digimon index (0 for single)", "default": 0 },
        { "name": "attribute_r", "bits": 2, "type": "int", "description": "Right Digimon attribute (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 7,
      "description": "COU, Shot W R (0 for single)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_w_r", "bits": 8, "type": "int", "description": "Right Digimon weak shot (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 8,
      "description": "COU, Shot S R (0 for single)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "shot_s_r", "bits": 8, "type": "int", "description": "Right Digimon strong shot (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 9,
      "description": "COU, Power R (0 for single)",
      "fields": [
        { "name": "cou", "bits": 4, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "power_r", "bits": 8, "type": "int", "description": "Right Digimon power (0 for single)", "default": 0 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 10,
      "description": "Battle results - checksum, dodges, and hits",
      "fields": [
        { "name": "check", "bits": 4, "type": "int", "description": "Checksum value", "calculated": true },
        { "name": "dodges", "bits": 4, "type": "int", "description": "Dodge pattern (4 bits)", "min": 0, "max": 15 },
        { "name": "hits", "bits": 4, "type": "int", "description": "Hit pattern (4 bits)", "min": 0, "max": 15 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    }
  ],

  "notes": {
    "hp": "HP varies by Digimon",
    "battle_turns": "Up to 6 turns (6 attacks)",
    "attribute_advantage": "Provides +32 power bonus",
    "checksum_calculation": "Ensures intended remainder when sum of nibbles % 16",
    "hit_dodge_inversion": "Dodge = 1 - hit for single battles",
    "attack_patterns": "15 patterns (0-14) with 6 attacks each, see attack_patterns/PENC.json"
  }
}
