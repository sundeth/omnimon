{
  "protocol": {
    "name": "DMC",
    "display_name": "DMC (Digital Monster Card Game)",
    "type": "battle",
    "version": "1.0",
    "description": "Digital Monster Card Battle System protocol",
    "packet_count": 2,
    "fixed_hp": null,
    "uses_minigame": true,
    "battle_mode": "single",
    "note": "DMC uses simple win/lose system based on power calculation"
  },

  "constants": {
    "COU": {
      "value": "0x47444C43",
      "type": "int",
      "description": "Magic constant 'GDLC' (0x47444C43)"
    },
    "VERSION": {
      "value": 1,
      "type": "int",
      "description": "Protocol version"
    },
    "TURNS": {
      "value": 5,
      "type": "int",
      "description": "Number of battle turns"
    }
  },

  "packets": [
    {
      "number": 1,
      "description": "Digimon Data Packet",
      "fields": [
        { "name": "cou", "bits": 32, "type": "int", "description": "Magic constant", "ref": "COU" },
        { "name": "operation", "bits": 16, "type": "int", "description": "Operation code (0-3)", "values": { "0": "device1_data", "1": "device2_data" } },
        { "name": "version", "bits": 16, "type": "int", "description": "Protocol version", "ref": "VERSION" },
        { "name": "index", "bits": 16, "type": "int", "description": "Digimon index" },
        { "name": "power", "bits": 16, "type": "int", "description": "Digimon power" },
        { "name": "attribute", "bits": 16, "type": "int", "description": "Digimon attribute", "values": { "0": "free", "1": "virus", "2": "data", "3": "vaccine" } },
        { "name": "check", "bits": 16, "type": "int", "description": "Checksum (sum of all 16-bit fields)", "calculated": true }
      ]
    },
    {
      "number": 2,
      "description": "Battle Data Packet",
      "fields": [
        { "name": "cou", "bits": 32, "type": "int", "description": "Magic constant", "ref": "COU" },
        { "name": "operation", "bits": 16, "type": "int", "description": "Operation code (0-3)", "values": { "2": "device1_result", "3": "device2_result" } },
        { "name": "shot", "bits": 16, "type": "int", "description": "Attack sprite ID" },
        { "name": "outcome", "bits": 16, "type": "int", "description": "Battle outcome", "values": { "0": "loss", "1": "win" } },
        { "name": "cou_repeat", "bits": 32, "type": "int", "description": "Placeholder COU", "default": 0 },
        { "name": "check", "bits": 16, "type": "int", "description": "Checksum (sum of all 16-bit fields)", "calculated": true }
      ]
    }
  ],

  "notes": {
    "exchange_sequence": "Device1 sends Packet1(op=0) -> Device2 responds Packet1(op=1) -> Device1 sends Packet2(op=2) -> Device2 responds Packet2(op=3)",
    "outcome_calculation": "Based on power comparison with attribute advantage (+5 if advantage)",
    "attribute_advantage": "Free>Virus, Virus>Data, Data>Vaccine, Vaccine>Free",
    "checksum": "Sum of all 16-bit fields (excluding checksum itself), keep lowest 16 bits",
    "battle_turns": "5 turns total, winner determined by outcome calculation"
  }
}
