{
  "protocol": {
    "name": "PENZ",
    "display_name": "PENZ (Pendulum Z)",
    "type": "battle",
    "version": "1.0",
    "description": "Digimon Pendulum Z battle protocol (same packet format as DMX)",
    "packet_count": 6,
    "fixed_hp": null,
    "uses_minigame": true,
    "minigame_type": "count_match",
    "battle_mode": "single",
    "attack_pattern_file": "attack_patterns/DMX.json"
  },

  "constants": {
    "EOL": {
      "value": 14,
      "bits": 4,
      "type": "int",
      "description": "End of line marker (0x0E = 1110 binary)"
    },
    "VERSION_BLACK": {
      "value": 0,
      "bits": 4,
      "type": "int",
      "description": "Version 1 - Black"
    },
    "COU": {
      "value": 0,
      "bits": 2,
      "type": "int",
      "description": "Constant or unknown field"
    },
    "TURNS": {
      "value": 5,
      "type": "int",
      "description": "Maximum number of battle turns"
    },
    "MAX_POWER": {
      "value": 255,
      "type": "int",
      "description": "Maximum power value (capped to prevent overflow)"
    }
  },

  "packets": [
    {
      "number": 1,
      "description": "Order, Level, Sick, Attack, Version, EOL",
      "fields": [
        { "name": "order", "bits": 1, "type": "int", "description": "Battle order (0=device1/replying, 1=device2/initiating)" },
        { "name": "level", "bits": 4, "type": "int", "description": "Experience level (0=level 1, 9=level 10)", "min": 0, "max": 9 },
        { "name": "sick", "bits": 1, "type": "int", "description": "Sick status", "values": { "0": "healthy", "1": "sick" } },
        { "name": "attack", "bits": 2, "type": "int", "description": "Attack quality from minigame (0=bad, 1=good, 2=great, 3=excellent)", "min": 0, "max": 3 },
        { "name": "version", "bits": 4, "type": "int", "description": "Device version", "ref": "VERSION_BLACK" },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 2,
      "description": "Stage, Index, Attribute, EOL",
      "fields": [
        { "name": "stage", "bits": 3, "type": "int", "description": "Evolution stage (0=Baby II, 5=Super Ultimate)", "min": 0, "max": 5 },
        { "name": "index", "bits": 7, "type": "int", "description": "Digimon roster index (per version)", "min": 0, "max": 127 },
        { "name": "attribute", "bits": 2, "type": "int", "description": "Digimon attribute", "values": { "0": "vaccine", "1": "data", "2": "virus", "3": "free" } },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 3,
      "description": "Shot S, Shot W, EOL",
      "fields": [
        { "name": "shot_s", "bits": 6, "type": "int", "description": "Strong shot sprite index", "min": 0, "max": 63 },
        { "name": "shot_w", "bits": 6, "type": "int", "description": "Weak shot sprite index", "min": 0, "max": 63 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 4,
      "description": "COU, HP, Shot M, EOL",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "hp", "bits": 5, "type": "int", "description": "Current HP", "min": 0, "max": 31 },
        { "name": "shot_m", "bits": 5, "type": "int", "description": "Medium shot sprite index", "min": 0, "max": 31 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 5,
      "description": "COU, Buff, Power, EOL",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "buff", "bits": 2, "type": "int", "description": "Buff damage bonus per hit (max 2)", "min": 0, "max": 2 },
        { "name": "power", "bits": 8, "type": "int", "description": "Power value (capped at 255)", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 6,
      "description": "Check, COU, Hits, EOL",
      "fields": [
        { "name": "check", "bits": 4, "type": "int", "description": "Checksum (makes sum % 16 == 8)", "calculated": true },
        { "name": "cou", "bits": 3, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "hits", "bits": 5, "type": "int", "description": "Hit pattern (5 bits for 5 turns, right to left)", "min": 0, "max": 31 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    }
  ],

  "notes": {
    "variable_hp": "HP varies by Digimon (5-bit field, max 31)",
    "minigame": "Count Match minigame - rotation result 1-3 maps to attack quality",
    "attack_quality": "0=bad, 1=good, 2=great, 3=excellent - determined by level + minigame",
    "attribute_advantage": "Provides +32 power bonus",
    "power_cap": "Power is capped at 255 to prevent overflow bugs from original device",
    "checksum_calculation": "Sum all nibbles, check nibble makes (sum + check) % 16 == 8",
    "hit_pattern": "5 bits for 5 turns, calculated based on power comparison",
    "battle_end": "Ends when one Digimon reaches 0 HP or after 5 turns",
    "tie_handling": "Ties cause freeze on real device - winner is higher HP, then initiator",
    "attribute_mapping": "Attribute encoding: Va=0, Da=1, Vi=2, Fr=3"
  }
}
  ],

  "notes": {
    "variable_hp": "HP is not fixed - varies by Digimon",
    "attribute_advantage": "Provides +32 power bonus",
    "checksum_calculation": "Ensures intended remainder 8 when sum of nibbles % 16",
    "hit_pattern": "5 bits for 5 turns, calculated based on power comparison",
    "battle_end": "Ends when one Digimon reaches 0 HP or after 5 turns",
    "level_system": "Experience levels 1-10 affect attack patterns",
    "buff_system": "Buff adds 0-2 additional damage per hit"
  }
}
