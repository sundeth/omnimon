{
  "protocol": {
    "name": "DMX",
    "display_name": "DMX (Digital Monster X)",
    "type": "battle",
    "version": "1.0",
    "description": "Digital Monster X device battle protocol",
    "packet_count": 6,
    "fixed_hp": null,
    "uses_minigame": true,
    "minigame_type": "xai",
    "battle_mode": "single",
    "attack_pattern_file": "attack_patterns/DMX.json"
  },

  "constants": {
    "EOL": {
      "value": 14,
      "bits": 4,
      "type": "int",
      "description": "End of line marker (0x0E = 1110 binary)"
    },
    "VERSION_BLACK": {
      "value": 0,
      "bits": 4,
      "type": "int",
      "description": "Version 1 - Black"
    },
    "COU": {
      "value": 0,
      "bits": 2,
      "type": "int",
      "description": "Constant or unknown field"
    },
    "TURNS": {
      "value": 5,
      "type": "int",
      "description": "Maximum number of battle turns"
    },
    "MAX_POWER": {
      "value": 255,
      "type": "int",
      "description": "Maximum power value (capped to prevent overflow)"
    }
  },

  "packets": [
    {
      "number": 1,
      "description": "Order, Level, Sick, Attack, Version",
      "fields": [
        { "name": "order", "bits": 1, "type": "int", "description": "Battle order (0=device1, 1=device2)" },
        { "name": "level", "bits": 4, "type": "int", "description": "Digimon level", "min": 0, "max": 15 },
        { "name": "sick", "bits": 1, "type": "int", "description": "Sick status", "values": { "0": "healthy", "1": "sick" } },
        { "name": "attack", "bits": 2, "type": "int", "description": "Attack pattern from minigame (0-3)", "min": 0, "max": 3 },
        { "name": "version", "bits": 4, "type": "int", "description": "Device version (use pet.version filtered 1..6)" }
      ]
    },
    {
      "number": 2,
      "description": "Stage, Index, Attribute",
      "fields": [
        { "name": "stage", "bits": 3, "type": "int", "description": "Evolution stage", "min": 0, "max": 7 },
        { "name": "index", "bits": 7, "type": "int", "description": "Digimon roster index (7 bits)", "min": 0, "max": 127 },
        { "name": "attribute", "bits": 2, "type": "int", "description": "Digimon attribute (0=Va,1=Da,2=Vi,3=Free)", "values": { "0": "vaccine", "1": "data", "2": "virus", "3": "free" } },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 3,
      "description": "Attack Sprites (Strong and Weak)",
      "fields": [
        { "name": "shot_s", "bits": 6, "type": "int", "description": "Strong shot sprite index (truncate to 6 bits)", "min": 0, "max": 63 },
        { "name": "shot_w", "bits": 6, "type": "int", "description": "Weak shot sprite index (truncate to 6 bits)", "min": 0, "max": 63 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 4,
      "description": "HP and Medium Shot",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "hp", "bits": 5, "type": "int", "description": "Current HP (variable)", "min": 0, "max": 31 },
        { "name": "shot_m", "bits": 5, "type": "int", "description": "Medium shot sprite index", "min": 0, "max": 31 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 5,
      "description": "Buff and Power",
      "fields": [
        { "name": "cou", "bits": 2, "type": "int", "ref": "COU" },
        { "name": "buff", "bits": 2, "type": "int", "description": "Buff status", "min": 0, "max": 3 },
        { "name": "power", "bits": 8, "type": "int", "description": "Power value", "min": 0, "max": 255 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    },
    {
      "number": 6,
      "description": "Battle results - checksum and hits",
      "fields": [
        { "name": "check", "bits": 4, "type": "int", "description": "Checksum value", "calculated": true },
        { "name": "cou", "bits": 3, "type": "int", "description": "Counter field", "default": 0 },
        { "name": "hits", "bits": 5, "type": "int", "description": "Hit pattern (5 bits for 5 turns)", "min": 0, "max": 31 },
        { "name": "eol", "bits": 4, "type": "int", "ref": "EOL" }
      ]
    }
  ],

  "notes": {
    "variable_hp": "HP is not fixed - varies by Digimon",
    "attribute_advantage": "Provides +32 power bonus",
    "checksum_calculation": "Checksum calculation: sum nibbles and choose check nibble so (sum + check) % 16 == 8",
    "hit_pattern": "5 bits for 5 turns, calculated based on power comparison",
    "battle_end": "Ends when one Digimon reaches 0 HP or after 5 turns"
    ,"attribute_mapping": "Attribute encoding: Va=0, Da=1, Vi=2, empty string/default=3"
  }
}
